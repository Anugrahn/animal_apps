// Cloudflare Workers deploy of Naura's Wonderf4ur World, the party
// edition (branch party-naura). See DEPLOY.md.
// Build command: sh tools/deploy/cf-build.sh    Deploy command: npx wrangler deploy
{
  "name": "naura-wonderfour",
  "compatibility_date": "2025-09-01",
  "main": "tools/deploy/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only voice clips pass through the worker (for Range requests)
    "run_worker_first": ["/voice/*"]
  }
}
